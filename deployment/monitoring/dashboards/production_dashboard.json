{
  "dashboard": {
    "title": "Decision Agent - Production Monitoring",
    "description": "Real-time monitoring for Decision Agent platform",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Inference API - Request Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(http_requests_total{service=\"decision-agent-api\"}[5m])",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "yaxes": [
          {
            "label": "Requests/sec",
            "format": "reqps"
          }
        ]
      },
      {
        "id": 2,
        "title": "Inference API - Latency (p50, p95, p99)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {
            "label": "Latency (ms)",
            "format": "ms"
          }
        ],
        "thresholds": [
          {
            "value": 100,
            "color": "red",
            "line": true,
            "label": "p95 target"
          }
        ]
      },
      {
        "id": 3,
        "title": "Inference API - Error Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(http_requests_total{service=\"decision-agent-api\",status=~\"5..\"}[5m]) / rate(http_requests_total{service=\"decision-agent-api\"}[5m])",
            "legendFormat": "5xx error rate"
          },
          {
            "expr": "rate(http_requests_total{service=\"decision-agent-api\",status=~\"4..\"}[5m]) / rate(http_requests_total{service=\"decision-agent-api\"}[5m])",
            "legendFormat": "4xx error rate"
          }
        ],
        "yaxes": [
          {
            "label": "Error Rate",
            "format": "percentunit"
          }
        ],
        "thresholds": [
          {
            "value": 0.01,
            "color": "red",
            "line": true,
            "label": "1% threshold"
          }
        ]
      },
      {
        "id": 4,
        "title": "Feature Cache - Hit Rate",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total)"
          }
        ],
        "format": "percentunit",
        "thresholds": {
          "steps": [
            {"value": 0, "color": "red"},
            {"value": 0.70, "color": "yellow"},
            {"value": 0.80, "color": "green"}
          ]
        }
      },
      {
        "id": 5,
        "title": "Feature Cache - Latency",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(redis_command_duration_seconds_bucket{command=\"get\"}[5m]))",
            "legendFormat": "p95 GET latency"
          }
        ],
        "yaxes": [
          {
            "label": "Latency (ms)",
            "format": "ms"
          }
        ]
      },
      {
        "id": 6,
        "title": "Model Predictions - Volume",
        "type": "graph",
        "datasource": "Databricks",
        "targets": [
          {
            "query": "SELECT DATE_TRUNC('hour', prediction_timestamp) as time, COUNT(*) as predictions FROM decision_agent.model_predictions_log WHERE prediction_timestamp > NOW() - INTERVAL 24 HOURS GROUP BY 1 ORDER BY 1"
          }
        ],
        "yaxes": [
          {
            "label": "Predictions/hour",
            "format": "short"
          }
        ]
      },
      {
        "id": 7,
        "title": "Model Performance - Prediction Distribution",
        "type": "histogram",
        "datasource": "Databricks",
        "targets": [
          {
            "query": "SELECT prediction FROM decision_agent.model_predictions_log WHERE prediction_timestamp > NOW() - INTERVAL 1 HOUR"
          }
        ]
      },
      {
        "id": 8,
        "title": "Model Drift - Feature Distribution Shift",
        "type": "heatmap",
        "datasource": "Databricks",
        "targets": [
          {
            "query": "SELECT metric_timestamp, feature_name, drift_score FROM decision_agent.feature_drift_metrics WHERE metric_timestamp > NOW() - INTERVAL 7 DAYS ORDER BY metric_timestamp"
          }
        ],
        "thresholds": {
          "steps": [
            {"value": 0, "color": "green"},
            {"value": 0.05, "color": "yellow"},
            {"value": 0.10, "color": "red"}
          ]
        }
      },
      {
        "id": 9,
        "title": "Streaming Pipeline - Throughput",
        "type": "graph",
        "datasource": "Databricks",
        "targets": [
          {
            "query": "SELECT window_end, events_processed FROM decision_agent.streaming_metrics WHERE window_end > NOW() - INTERVAL 1 HOUR ORDER BY window_end"
          }
        ],
        "yaxes": [
          {
            "label": "Events/sec",
            "format": "short"
          }
        ]
      },
      {
        "id": 10,
        "title": "Streaming Pipeline - Processing Lag",
        "type": "graph",
        "datasource": "Databricks",
        "targets": [
          {
            "query": "SELECT window_end, processing_lag_seconds FROM decision_agent.streaming_metrics WHERE window_end > NOW() - INTERVAL 1 HOUR ORDER BY window_end"
          }
        ],
        "yaxes": [
          {
            "label": "Lag (seconds)",
            "format": "s"
          }
        ],
        "thresholds": [
          {
            "value": 10,
            "color": "red",
            "line": true,
            "label": "10s threshold"
          }
        ]
      },
      {
        "id": 11,
        "title": "Active Alerts",
        "type": "table",
        "datasource": "Databricks",
        "targets": [
          {
            "query": "SELECT alert_type, severity, message, alert_timestamp FROM decision_agent.alerts_log WHERE acknowledged = false AND alert_timestamp > NOW() - INTERVAL 24 HOURS ORDER BY alert_timestamp DESC LIMIT 10"
          }
        ]
      },
      {
        "id": 12,
        "title": "System Health",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "up{job=\"decision-agent-api\"}",
            "legendFormat": "API"
          },
          {
            "expr": "redis_up",
            "legendFormat": "Redis"
          },
          {
            "expr": "databricks_cluster_state{cluster_name=~\"decision-agent.*\"}",
            "legendFormat": "{{cluster_name}}"
          }
        ],
        "valueMappings": [
          {"value": 1, "text": "UP", "color": "green"},
          {"value": 0, "text": "DOWN", "color": "red"}
        ]
      }
    ]
  }
}
